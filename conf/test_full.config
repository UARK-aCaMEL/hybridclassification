/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    The bundled test data, run with the default analysis settings (a 500-locus
    panel, full-length NewHybrids runs and 10 ADMIXTURE replicates per K).

    Use as follows:
        nextflow run UARK-aCaMEL/hybridclassification -profile test_full,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'The test dataset, run with the default analysis settings'

    // Input data
    input        = "${projectDir}/assets/test.vcf.gz"
    speciesmap   = "${projectDir}/assets/speciesmap.tsv"
    popmap       = "${projectDir}/assets/popmap.tsv"
    site_coords  = "${projectDir}/assets/site_coords.tsv"
    combinations = "${projectDir}/assets/combinations.tsv"
}
